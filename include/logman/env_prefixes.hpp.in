#pragma once

/// @file
/// @brief Compile-time list of env-var prefixes the runtime scans. Generated by
///        CMake from the LOGMAN_ENV_PREFIXES cache variable. "LOGMAN_" is
///        always included unconditionally.

#include <array>
#include <span>
#include <string_view>

#define LOGMAN_DEFAULT_ENV_PREFIXES_RAW "@LOGMAN_DEFAULT_ENV_PREFIXES_RAW@"

namespace logman {

namespace detail {

inline constexpr std::string_view k_default_env_prefixes_raw = LOGMAN_DEFAULT_ENV_PREFIXES_RAW;

consteval std::size_t count_prefixes() {
    if (k_default_env_prefixes_raw.empty()) {
        return 0;
    }
    std::size_t n = 1;
    for (char c : k_default_env_prefixes_raw) {
        if (c == ';') {
            ++n;
        }
    }
    return n;
}

template <std::size_t N>
consteval std::array<std::string_view, N> parse_prefixes() {
    std::array<std::string_view, N> out{};
    std::size_t idx   = 0;
    std::size_t start = 0;
    for (std::size_t i = 0; i < k_default_env_prefixes_raw.size(); ++i) {
        if (k_default_env_prefixes_raw[i] == ';') {
            out[idx++] = k_default_env_prefixes_raw.substr(start, i - start);
            start      = i + 1;
        }
    }
    if (idx < N) {
        out[idx] = k_default_env_prefixes_raw.substr(start);
    }
    return out;
}

inline constexpr auto k_default_env_prefixes_storage =
    parse_prefixes<count_prefixes()>();

}  // namespace detail

/// Prefixes (including the trailing underscore) the runtime scans for env vars
/// during `LogManager::initialize()`. Always includes `LOGMAN_`; consumers may
/// append more via the `LOGMAN_ENV_PREFIXES` CMake cache variable, or extend
/// `InitConfig::env_prefixes` at runtime.
inline constexpr std::span<const std::string_view> default_env_prefixes{
    detail::k_default_env_prefixes_storage};

}  // namespace logman
